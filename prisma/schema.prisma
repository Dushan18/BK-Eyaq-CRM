// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// Data Base

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  UNKNOWN
  FAILED
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  OTHER
}

enum MessagingOutboxStatus {
  PENDING
  PUBLISHED
  COMPLETED
  FAILED
}

model Conversation {
  id                     String         @id @default(uuid())
  customerId             String
  channel                ContactChannel
  externalConversationId String?        @db.VarChar(255)
  isAssistantPaused      Boolean        @default(false)
  assignedUserId         String?
  lastMessageAt          DateTime?      @db.Timestamptz(3)
  lastSequence           Int            @default(0)
  createdAt              DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime       @updatedAt @db.Timestamptz(3)
  customer               Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignedUser           User?          @relation("ConversationAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages               Message[]

  @@unique([customerId, channel])
  // Necesario como destino de FK compuesta para impedir Message.channel distinto.
  @@unique([id, channel])
  @@index([channel, lastMessageAt, id])
  @@index([lastMessageAt, id])
  @@index([assignedUserId, lastMessageAt, id])
  @@map("conversations")
}

model Message {
  id                 String              @id @default(uuid())
  conversationId     String
  channel            ContactChannel
  sequence           Int
  externalMessageId  String?             @db.VarChar(255)
  direction          MessageDirection
  status             MessageStatus
  type               MessageType
  content            String?             @db.Text
  authorUserId       String?
  occurredAt         DateTime?           @db.Timestamptz(3)
  receivedAt         DateTime?           @db.Timestamptz(3)
  processedAt        DateTime?           @db.Timestamptz(3)
  sentAt             DateTime?           @db.Timestamptz(3)
  failedAt           DateTime?           @db.Timestamptz(3)
  readAt             DateTime?           @db.Timestamptz(3)
  deliveredAt        DateTime?           @db.Timestamptz(3)
  providerReadAt     DateTime?           @db.Timestamptz(3)
  idempotencyKey     String?             @db.VarChar(80)
  recipientPhone     String?             @db.VarChar(16)
  providerAccountId  String?             @db.VarChar(80)
  processingAttempts Int                 @default(0)
  processingToken    String?             @db.VarChar(36)
  processingUntil    DateTime?           @db.Timestamptz(3)
  errorCode          String?             @db.VarChar(80)
  errorReason        String?             @db.VarChar(300)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  conversation       Conversation        @relation(fields: [conversationId, channel], references: [id, channel], onDelete: Restrict)
  author             User?               @relation("MessageAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  attachments        MessageAttachment[]
  outbox             MessagingOutbox?

  @@unique([channel, externalMessageId])
  @@unique([conversationId, sequence])
  @@unique([conversationId, idempotencyKey])
  @@index([conversationId, direction, occurredAt])
  @@index([conversationId, direction, readAt])
  @@index([status, processingUntil])
  @@map("messages")
}

// Normalized delivery receipts only: no raw webhook, tokens or provider error text.
model MessageStatusEvent {
  id                String         @id @default(uuid())
  channel           ContactChannel
  providerAccountId String         @db.VarChar(80)
  externalMessageId String         @db.VarChar(255)
  status            MessageStatus
  occurredAt        DateTime       @db.Timestamptz(3)
  processedAt       DateTime?      @db.Timestamptz(3)
  availableAt       DateTime       @default(now()) @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)

  @@unique([channel, providerAccountId, externalMessageId, status, occurredAt], map: "message_status_events_dedup_key")
  @@index([processedAt, availableAt])
  @@map("message_status_events")
}

// Quarantine fingerprint for authenticated but malformed events; no content/PII.
model MessagingWebhookRejection {
  fingerprint String   @id @db.VarChar(64)
  code        String   @db.VarChar(80)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@map("messaging_webhook_rejections")
}

model MessageAttachment {
  id              String      @id @default(uuid())
  messageId       String
  type            MessageType
  fileName        String?     @db.VarChar(255)
  mimeType        String?     @db.VarChar(150)
  sizeBytes       Int?
  externalMediaId String?     @db.VarChar(255)
  url             String?     @db.VarChar(2048)
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  message         Message     @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

model MessagingOutbox {
  id              String                @id @default(uuid())
  messageId       String                @unique
  status          MessagingOutboxStatus @default(PENDING)
  publishAttempts Int                   @default(0)
  availableAt     DateTime              @default(now()) @db.Timestamptz(3)
  publishedAt     DateTime?             @db.Timestamptz(3)
  completedAt     DateTime?             @db.Timestamptz(3)
  leaseToken      String?               @db.VarChar(36)
  leaseUntil      DateTime?             @db.Timestamptz(3)
  lastErrorCode   String?               @db.VarChar(80)
  createdAt       DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @db.Timestamptz(3)
  message         Message               @relation(fields: [messageId], references: [id], onDelete: Restrict)

  @@index([status, availableAt, leaseUntil])
  @@map("messaging_outbox")
}

enum RoleCode {
  ADMIN
  OWNER
  OPERATOR
  SUPPORT
}

enum RestaurantConfigScope {
  GLOBAL
}

enum CurrencyCode {
  PEN
  USD
}

enum LanguageCode {
  ES
  EN
  PT
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum CommercialItemType {
  DISH
  BEVERAGE
  SERVICE
  PROMOTION
  EVENT
}

enum CommercialApprovalStatus {
  DRAFT
  APPROVED
  REJECTED
}

model User {
  assignedConversations  Conversation[]                 @relation("ConversationAssignee")
  authoredMessages       Message[]                      @relation("MessageAuthor")
  assignedReservations   Reservation[]                  @relation("ReservationAssignee")
  reservationNotes       ReservationNote[]              @relation("ReservationNoteAuthor")
  reservationReschedules ReservationRescheduleHistory[] @relation("ReservationRescheduleAuthor")
  id                     String                         @id @default(uuid())
  firstName              String
  lastName               String
  email                  String                         @unique
  passwordHash           String
  isActive               Boolean                        @default(true)
  lastLoginAt            DateTime?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  roles                  UserRole[]
  sessions               Session[]
  passwordResetTokens    PasswordResetToken[]
  approvalResponsibleFor RestaurantConfig[]   @relation("RestaurantApprovalResponsible")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  code        RoleCode @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model RestaurantConfig {
  id                     String                @id @default(uuid())
  scope                  RestaurantConfigScope @unique @default(GLOBAL)
  businessName           String                @db.VarChar(150)
  logoUrl                String?               @db.VarChar(2048)
  description            String?               @db.Text
  address                String                @db.VarChar(300)
  latitude               Decimal?              @db.Decimal(10, 7)
  longitude              Decimal?              @db.Decimal(10, 7)
  whatsappNumber         String                @db.VarChar(16)
  email                  String                @db.VarChar(320)
  website                String?               @db.VarChar(2048)
  currency               CurrencyCode          @default(PEN)
  timeZone               String                @default("America/Lima") @db.VarChar(64)
  reservationPolicy      String                @db.Text
  cancellationPolicy     String                @db.Text
  responseTimeoutMinutes Int
  approvalResponsibleId  String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  approvalResponsible User?                @relation("RestaurantApprovalResponsible", fields: [approvalResponsibleId], references: [id], onDelete: SetNull)
  schedules           RestaurantSchedule[]
  languages           RestaurantLanguage[]

  @@index([approvalResponsibleId])
  @@map("restaurant_configs")
}

model RestaurantSchedule {
  restaurantConfigId String
  dayOfWeek          DayOfWeek
  isOpen             Boolean   @default(false)
  openTime           String?   @db.VarChar(5)
  closeTime          String?   @db.VarChar(5)

  restaurantConfig RestaurantConfig @relation(fields: [restaurantConfigId], references: [id], onDelete: Cascade)

  @@id([restaurantConfigId, dayOfWeek])
  @@map("restaurant_schedules")
}

model RestaurantLanguage {
  restaurantConfigId String
  language           LanguageCode

  restaurantConfig RestaurantConfig @relation(fields: [restaurantConfigId], references: [id], onDelete: Cascade)

  @@id([restaurantConfigId, language])
  @@map("restaurant_languages")
}

model CommercialCategory {
  id               String   @id @default(uuid())
  sourceKey        String?  @unique @db.VarChar(120)
  nameEs           String?  @db.VarChar(150)
  nameEn           String?  @db.VarChar(150)
  normalizedNameEs String?  @unique @db.VarChar(150)
  normalizedNameEn String?  @unique @db.VarChar(150)
  descriptionEs    String?  @db.Text
  descriptionEn    String?  @db.Text
  isActive         Boolean  @default(true)
  displayOrder     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items CommercialItem[]

  @@index([isActive, displayOrder])
  @@map("commercial_categories")
}

model CommercialItem {
  reservationRequests ReservationRequest[]
  reservations        Reservation[]
  customerInterests   CustomerInterest[]
  id                  String                   @id @default(uuid())
  sourceKey           String?                  @unique @db.VarChar(160)
  type                CommercialItemType
  categoryId          String
  nameEs              String?                  @db.VarChar(200)
  nameEn              String?                  @db.VarChar(200)
  normalizedName      String                   @db.VarChar(200)
  descriptionEs       String?                  @db.Text
  descriptionEn       String?                  @db.Text
  basePrice           Decimal?                 @db.Decimal(10, 2)
  displayOrder        Int                      @default(0)
  isActive            Boolean                  @default(true)
  approvalStatus      CommercialApprovalStatus @default(DRAFT)
  conditions          String?                  @db.Text
  internalNotes       String?                  @db.Text
  availabilityNote    String?                  @db.Text
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  category        CommercialCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants        CommercialItemVariant[]
  images          CommercialItemImage[]
  faqs            CommercialItemFaq[]
  schedules       CommercialItemSchedule[]
  promotionDetail PromotionDetail?
  eventDetail     EventDetail?

  @@index([type])
  @@index([categoryId, displayOrder])
  @@index([isActive])
  @@index([approvalStatus, isActive])
  @@index([createdAt])
  @@index([normalizedName])
  @@map("commercial_items")
}

model CommercialItemVariant {
  id               String   @id @default(uuid())
  commercialItemId String
  nameEs           String?  @db.VarChar(150)
  nameEn           String?  @db.VarChar(150)
  normalizedName   String   @db.VarChar(150)
  descriptionEs    String?  @db.Text
  descriptionEn    String?  @db.Text
  price            Decimal  @db.Decimal(10, 2)
  isActive         Boolean  @default(true)
  displayOrder     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  commercialItem CommercialItem @relation(fields: [commercialItemId], references: [id], onDelete: Cascade)

  @@unique([commercialItemId, normalizedName])
  @@index([commercialItemId, isActive, displayOrder])
  @@map("commercial_item_variants")
}

model CommercialItemImage {
  id               String   @id @default(uuid())
  commercialItemId String
  url              String   @db.VarChar(2048)
  altTextEs        String?  @db.VarChar(300)
  altTextEn        String?  @db.VarChar(300)
  isPrimary        Boolean  @default(false)
  displayOrder     Int      @default(0)
  createdAt        DateTime @default(now())

  commercialItem CommercialItem @relation(fields: [commercialItemId], references: [id], onDelete: Cascade)

  @@unique([commercialItemId, url])
  @@unique([commercialItemId], map: "commercial_item_images_one_primary_key", where: { isPrimary: true })
  @@index([commercialItemId, displayOrder])
  @@map("commercial_item_images")
}

model CommercialItemFaq {
  id               String   @id @default(uuid())
  commercialItemId String
  questionEs       String   @db.VarChar(500)
  questionEn       String?  @db.VarChar(500)
  answerEs         String   @db.Text
  answerEn         String?  @db.Text
  displayOrder     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  commercialItem CommercialItem @relation(fields: [commercialItemId], references: [id], onDelete: Cascade)

  @@index([commercialItemId, displayOrder])
  @@map("commercial_item_faqs")
}

model CommercialItemSchedule {
  id               String    @id @default(uuid())
  commercialItemId String
  dayOfWeek        DayOfWeek
  isAvailable      Boolean   @default(false)
  startTime        String?   @db.VarChar(5)
  endTime          String?   @db.VarChar(5)

  commercialItem CommercialItem @relation(fields: [commercialItemId], references: [id], onDelete: Cascade)

  @@unique([commercialItemId, dayOfWeek])
  @@index([commercialItemId])
  @@map("commercial_item_schedules")
}

model PromotionDetail {
  id               String    @id @default(uuid())
  commercialItemId String    @unique
  validFrom        DateTime?
  validUntil       DateTime?
  promotionalPrice Decimal?  @db.Decimal(10, 2)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  commercialItem CommercialItem @relation(fields: [commercialItemId], references: [id], onDelete: Cascade)

  @@map("promotion_details")
}

model EventDetail {
  id               String    @id @default(uuid())
  commercialItemId String    @unique
  startAt          DateTime?
  endAt            DateTime?
  capacity         Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  commercialItem CommercialItem @relation(fields: [commercialItemId], references: [id], onDelete: Cascade)

  @@map("event_details")
}

enum CustomerStatus {
  NEW
  INTERESTED
  IN_CONVERSATION
  REQUESTED_RESERVATION
  CONFIRMED
  REJECTED
  LOST
  RECURRENT
}

enum ContactChannel {
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  WEBSITE
  PHONE
  EMAIL
  OTHER
}

model Customer {
  conversations       Conversation[]
  reservationRequests ReservationRequest[]
  reservations        Reservation[]
  id                  String               @id @default(uuid())
  firstName           String?              @db.VarChar(100)
  lastName            String?              @db.VarChar(100)
  phone               String?              @db.VarChar(80)
  phoneCountry        String?              @db.VarChar(2)
  normalizedPhone     String?              @unique @db.VarChar(16)
  email               String?              @db.VarChar(320)
  normalizedEmail     String?              @unique @db.VarChar(320)
  sourceChannel       ContactChannel
  status              CustomerStatus       @default(NEW)
  firstContactAt      DateTime             @default(now())
  lastContactAt       DateTime             @default(now())
  notes               String?              @db.Text
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  interests           CustomerInterest[]

  @@index([status])
  @@index([sourceChannel])
  @@index([lastContactAt, id])
  @@index([createdAt])
  @@map("customers")
}

model CustomerInterest {
  id                String         @id @default(uuid())
  customerId        String
  commercialItemId  String
  firstInterestedAt DateTime       @default(now())
  lastInterestedAt  DateTime       @default(now())
  notes             String?        @db.Text
  customer          Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  commercialItem    CommercialItem @relation(fields: [commercialItemId], references: [id], onDelete: Restrict)

  @@unique([customerId, commercialItemId])
  @@index([commercialItemId])
  @@map("customer_interests")
}

enum ReservationRequestStatus {
  INCOMPLETE_DATA
  READY_TO_SEND
  SENT_TO_OWNER
  WAITING_RESPONSE
  ACCEPTED
  REJECTED
  MODIFICATION_REQUESTED
  RENEGOTIATING
  CANCELLED
}

enum ReservationStatus {
  CONFIRMED
  UPCOMING
  IN_SERVICE
  COMPLETED
  RESCHEDULED
  CANCELLED
  NO_SHOW
}

model ReservationRequest {
  id                  String                   @id @default(uuid())
  code                String                   @unique @db.VarChar(40)
  customerId          String
  commercialItemId    String?
  sourceChannel       ContactChannel
  reservationAt       DateTime?                @db.Timestamptz(3)
  numberOfPeople      Int?
  quotedPrice         Decimal?                 @db.Decimal(10, 2)
  currency            CurrencyCode?
  comments            String?                  @db.Text
  specialRequirements String?                  @db.Text
  status              ReservationRequestStatus @default(INCOMPLETE_DATA)
  createdAt           DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                 @updatedAt @db.Timestamptz(3)
  customer            Customer                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  commercialItem      CommercialItem?          @relation(fields: [commercialItemId], references: [id], onDelete: Restrict)
  reservation         Reservation?

  @@index([createdAt, id])
  @@index([status, createdAt])
  @@index([customerId])
  @@index([commercialItemId])
  @@index([sourceChannel])
  @@index([reservationAt])
  @@map("reservation_requests")
}

model Reservation {
  assignedUserId       String?
  assignedUser         User?                          @relation("ReservationAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  noteHistory          ReservationNote[]
  rescheduleHistory    ReservationRescheduleHistory[]
  id                   String                         @id @default(uuid())
  code                 String                         @unique @db.VarChar(40)
  reservationRequestId String?                        @unique
  customerId           String
  commercialItemId     String?
  reservationAt        DateTime                       @db.Timestamptz(3)
  numberOfPeople       Int
  status               ReservationStatus              @default(CONFIRMED)
  notes                String?                        @db.Text
  createdAt            DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                       @updatedAt @db.Timestamptz(3)
  reservationRequest   ReservationRequest?            @relation(fields: [reservationRequestId], references: [id], onDelete: Restrict)
  customer             Customer                       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  commercialItem       CommercialItem?                @relation(fields: [commercialItemId], references: [id], onDelete: Restrict)

  @@index([reservationAt, id])
  @@index([status, reservationAt])
  @@index([customerId])
  @@index([commercialItemId])
  @@index([assignedUserId, reservationAt])
  @@map("reservations")
}

model ReservationNote {
  id            String      @id @default(uuid())
  reservationId String
  authorUserId  String
  content       String      @db.VarChar(5000)
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  author        User        @relation("ReservationNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([reservationId, createdAt, id])
  @@index([authorUserId])
  @@map("reservation_notes")
}

model ReservationRescheduleHistory {
  id                    String      @id @default(uuid())
  reservationId         String
  previousReservationAt DateTime    @db.Timestamptz(3)
  newReservationAt      DateTime    @db.Timestamptz(3)
  reason                String?     @db.VarChar(5000)
  changedByUserId       String
  createdAt             DateTime    @default(now()) @db.Timestamptz(3)
  reservation           Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  changedBy             User        @relation("ReservationRescheduleAuthor", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([reservationId, createdAt, id])
  @@index([changedByUserId])
  @@map("reservation_reschedule_history")
}
