PORT=3000

# Activa workers/dispatcher solo cuando Redis esté configurado.
# Los endpoints y la persistencia PostgreSQL funcionan con workers apagados.
MESSAGING_ENABLED=false
REDIS_URL="redis://127.0.0.1:6379/0"
MESSAGING_QUEUE_PREFIX="eyaq-messaging"

DATABASE_URL="postgresql://usuario:password@localhost:5432/crm_eyaq"

JWT_SECRET="reemplazar-por-un-secreto-seguro"
JWT_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="reemplazar-por-otro-secreto-seguro"
JWT_REFRESH_EXPIRES_IN="7d"

ADMIN_EMAIL="admin@eyaq.systems"
ADMIN_PASSWORD="EyaqSystems2026"

PASSWORD_RESET_TOKEN_TTL_MINUTES=15
FRONTEND_RESET_PASSWORD_URL="http://localhost:5173/reset-password"

# Crea la clave en https://resend.com/api-keys
RESEND_API_KEY="re_reemplazar-por-api-key"
# Para pruebas iniciales puedes usar onboarding@resend.dev.
# En producción utiliza un remitente de un dominio verificado.
RESEND_FROM_EMAIL="EYAQ Systems <onboarding@resend.dev>"

# WhatsApp es opt-in; requiere MESSAGING_ENABLED=true y REDIS_URL.
WHATSAPP_ENABLED=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=
META_APP_SECRET=
