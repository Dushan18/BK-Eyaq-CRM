# bk-crm: plantilla de variables para PRODUCCIÓN (Dokploy). Sin secretos: los valores vacíos
# o entre <...> se completan en Dokploy › Environment, nunca en el repositorio.
# Con NODE_ENV=production (lo fija la imagen), el arranque se detiene si los JWT son débiles,
# si FRONTEND_RESET_PASSWORD_URL no es https pública o si RESEND_FROM_EMAIL es de resend.dev.

# --- Servidor ---
PORT=3000
# Traefik de Dokploy es un proxy delante del API: la IP real del cliente para el rate limiting.
TRUST_PROXY=1
# El contenedor aplica las migraciones pendientes al arrancar (respalda la base antes).
RUN_MIGRATIONS=true

# --- Base de datos y Redis (servicios internos de Dokploy; usa sus "Internal Connection URL") ---
DATABASE_URL=postgresql://<usuario>:<contraseña>@<host-interno-postgres>:5432/bd_crm?schema=public
REDIS_URL=redis://default:<contraseña>@<host-interno-redis>:6379
# Prefijo de las colas BullMQ. Distinto por entorno si dos entornos compartieran un Redis.
MESSAGING_QUEUE_PREFIX=eyaq-messaging
# Workers de mensajería (entrada y salida). Requerido por WhatsApp, Messenger, Instagram y Samanta.
MESSAGING_ENABLED=true

# --- Autenticación (secretos aleatorios de 32+ caracteres, distintos entre sí) ---
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
# Solo para el seed inicial (node dist/prisma/seed.js): primer usuario ADMIN.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Correo de recuperación de contraseña (Resend) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=CRM Sabor Mágico <no-reply@<dominio-verificado-en-resend>>
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
FRONTEND_RESET_PASSWORD_URL=https://panel.perucheck.cloud/reset-password

# --- Meta: WhatsApp Cloud API ---
WHATSAPP_ENABLED=true
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v26.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# Secreto de la app de Meta: valida la firma X-Hub-Signature-256 de todos los webhooks.
META_APP_SECRET=

# --- Meta: Messenger ---
MESSENGER_ENABLED=true
MESSENGER_PAGE_ID=
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_VERIFY_TOKEN=
MESSENGER_API_VERSION=v26.0

# --- Meta: Instagram ---
INSTAGRAM_ENABLED=true
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_API_VERSION=v26.0

# --- Samanta (OpenAI; cada respuesta es una llamada facturable) ---
SAMANTA_ENABLED=true
OPENAI_API_KEY=
SAMANTA_MODEL=gpt-6-luna
SAMANTA_DAILY_LIMIT=300
SAMANTA_CONCURRENT_LIMIT=1
SAMANTA_TIMEOUT_MS=20000
SAMANTA_MAX_OUTPUT_TOKENS=4096
SAMANTA_AUTO_ENABLED=true
# false = modo sombra (borradores READY, nada sale). true = responde sola a los clientes.
SAMANTA_AUTO_SEND=false
SAMANTA_AUTO_CHANNELS=WHATSAPP,FACEBOOK,INSTAGRAM
SAMANTA_AUTO_DELAY_MS=8000
SAMANTA_AUTO_MAX_PER_HOUR=12

# --- Reservas de la web por correo (IMAP) ---
EMAIL_ENABLED=true
EMAIL_IMAP_HOST=mail.sabormagicorestaurant.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_SECURE=true
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_MAILBOX=INBOX
EMAIL_POLL_SECONDS=60
EMAIL_IMPORT_SINCE_DAYS=30
WEB_RESERVATION_SENDERS=reservas@sabormagicorestaurant.com
WEB_RESERVATION_HOSTING_ACCOUNT=sabormgic
WEB_RESERVATION_WHATSAPP=false
WEB_RESERVATION_CONTACT_MAX_HOURS=24
WEB_RESERVATION_TEMPLATE=solicitud_reserva_web
WEB_RESERVATION_TEMPLATE_LANGUAGES=es
WEB_RESERVATION_DAILY_LIMIT=50

# --- Aprobación del propietario por WhatsApp (M9) ---
OWNER_APPROVAL_ENABLED=true
OWNER_APPROVAL_TEMPLATE=aprobacion_reserva_propietario
OWNER_APPROVAL_TEMPLATE_LANGUAGE=es
OWNER_APPROVAL_MAX_AGE_HOURS=24
OWNER_APPROVAL_POLL_SECONDS=15
# TEMPORAL mientras Meta revisa la plantilla: la solicitud sale como texto (ventana de 24 h del
# propietario abierta). Pásalo a false cuando la plantilla esté aprobada.
OWNER_APPROVAL_TEXT_FALLBACK_ENABLED=true
# Avisos al cliente con plantillas (ventana cerrada). Solo con las plantillas aprobadas en Meta.
CUSTOMER_DECISION_TEMPLATES_ENABLED=false
CUSTOMER_DECISION_TEMPLATE_ACCEPTED=reserva_aprobada
CUSTOMER_DECISION_TEMPLATE_REJECTED=reserva_no_aprobada
CUSTOMER_DECISION_TEMPLATE_CHANGE=reserva_cambio_propuesto
CUSTOMER_DECISION_TEMPLATE_LANGUAGE=es
