PORT=3000

# En producción usa NODE_ENV=production: el backend no arranca si JWT_SECRET,
# JWT_REFRESH_SECRET, FRONTEND_RESET_PASSWORD_URL o RESEND_FROM_EMAIL siguen
# con valores de desarrollo o de ejemplo.
NODE_ENV=development

# Solo detrás de un proxy inverso (Nginx, balanceador) que envía X-Forwarded-For:
# número de saltos de confianza (p. ej. 1) o direcciones/subredes del proxy.
# Vacío = se usa la IP de la conexión.
TRUST_PROXY=

# Activa workers/dispatcher solo cuando Redis esté configurado.
# Los endpoints y la persistencia PostgreSQL funcionan con workers apagados.
MESSAGING_ENABLED=false
REDIS_URL="redis://127.0.0.1:6379/0"
MESSAGING_QUEUE_PREFIX="eyaq-messaging"

DATABASE_URL="postgresql://usuario:password@localhost:5432/crm_eyaq"

# Secretos aleatorios de al menos 32 caracteres y distintos entre sí, p. ej.:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="reemplazar-por-un-secreto-seguro"
JWT_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="reemplazar-por-otro-secreto-seguro"
# La sesión vence igualmente a los 7 días del login, aunque se renueve.
JWT_REFRESH_EXPIRES_IN="7d"

# El seed solo usa esta contraseña al crear el administrador: en producción, una propia.
ADMIN_EMAIL="admin@eyaq.systems"
ADMIN_PASSWORD="EyaqSystems2026"

PASSWORD_RESET_TOKEN_TTL_MINUTES=15
# En producción, la URL https pública de la pantalla de restablecimiento del frontend.
FRONTEND_RESET_PASSWORD_URL="http://localhost:5173/reset-password"

# Crea la clave en https://resend.com/api-keys
RESEND_API_KEY="re_reemplazar-por-api-key"
# Para pruebas iniciales puedes usar onboarding@resend.dev.
# En producción utiliza un remitente de un dominio verificado.
RESEND_FROM_EMAIL="EYAQ Systems <onboarding@resend.dev>"

# WhatsApp es opt-in; requiere MESSAGING_ENABLED=true y REDIS_URL.
WHATSAPP_ENABLED=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=
META_APP_SECRET=

# Messenger: token DE LA PAGINA (no el token de WhatsApp ni el JWT del CRM).
# Aplicar la migracion de Messenger antes de reiniciar este backend.
# Mantener desactivado hasta completar credenciales y preparar el webhook.
MESSENGER_ENABLED=false
MESSENGER_PAGE_ID=
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_VERIFY_TOKEN=
MESSENGER_API_VERSION=v26.0
# Reutiliza META_APP_SECRET solo cuando ambos canales pertenecen a la misma app.

# Instagram Unified Login: recepción de mensajes (envío pendiente).
# Aplicar la migración instagram_inbound antes de activar. Requiere MESSAGING_ENABLED y Redis.
INSTAGRAM_ENABLED=false
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_VERIFY_TOKEN=
# Usa META_APP_SECRET de la app dueña del webhook.
# Opcional: token con instagram_manage_messages para responder desde el CRM y guardar el nombre
# del perfil (sin él, Instagram solo recibe). Con token, INSTAGRAM_API_VERSION es obligatoria.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_API_VERSION=v26.0

# Samanta v1: borradores manuales. Desactivada hasta aplicar la migración y configurar la clave.
SAMANTA_ENABLED=false
OPENAI_API_KEY=
SAMANTA_MODEL=gpt-6-luna
SAMANTA_DAILY_LIMIT=100
SAMANTA_CONCURRENT_LIMIT=2
SAMANTA_TIMEOUT_MS=20000
SAMANTA_MAX_OUTPUT_TOKENS=1024
